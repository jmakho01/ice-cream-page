<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Ice Cream Order Form</title>
  <link rel="stylesheet" href="/styles/ice-cream.css">
  <link rel = "icon" href = "/images/pixel-cone.jpg">
  <script src = "js/ice-cream.js" defer></script>
</head>
<body>

  <div class="reservation-box">
    <h1>Thank you for your order, <%= order.name %>!</h1>
      <h2>Order Summary</h2>
      <p>Name: <%= order.name %></p>
      <p>Email: <%= order.email %></p>
      <p>Flavor: <%= order.flavor %></p>
      <p>Cone: <%= order.cone %></p>
      <p>Toppings: <%= order.toppings %></p>
      <p>Date/Time: <%= order.timestamp %></p>
    </header>
  </div>

</body>
</html>
